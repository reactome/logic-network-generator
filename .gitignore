# Local agent / editor settings.
# Personal machine state (settings.local.json holds per-developer permission
# rules, sometimes with credentials in command strings) stays local. The
# spec-kit agent commands under .claude/skills/ ARE tracked so the
# /speckit-* workflow works on a fresh clone without re-running `specify init`.
.claude/*
!.claude/skills/

# Log files
*.log
debug_log.txt
debug_run.log
pathway_generation.log
test_generation.log

# Python bytecode files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
*.coverage

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.bak

# Environment variables
.env
.env.*
!.env.example

# Output folders of results. Generation runs use --output-dir with sibling
# names (output_tlp, output_r97, output_diag_on, ...), so ignore the whole
# family — otherwise a `git add -A` commits hundreds of generated networks.
output
output_*/

# Generated data files
db_id_to_name_mapping.tsv
pathway_logic_network_*.csv
uuid_mapping_*.csv
reaction_connections_*.csv
decomposed_uid_mapping_*.csv
best_matches_*.csv
graphify-out/
